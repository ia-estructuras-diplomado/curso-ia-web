{
  "mcpServers": {
    "normas": {
      "command": "uvx",
      "args": ["--from", "knowledge-rag==4.9.0", "knowledge-rag"],
      "env": {
        "KNOWLEDGE_RAG_DIR": "../lab5/rag",
        "PYTHONPATH": "../mcp"
      }
    },
    "excel": {
      "command": "uvx",
      "args": ["--from", "excel-mcp-server==0.1.8", "excel-mcp-server", "stdio"]
    },
    "etabs": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--isolated",
        "--no-progress",
        "--quiet",
        "python",
        "../mcp/launch_etabs.py"
      ]
    },
    "auto-ontology": {
      "command": "uvx",
      "args": ["--from", "git+https://github.com/gogoymh/auto-ontology-mcp", "auto-ontology-mcp"],
      "env": {
        "AUTO_ONTOLOGY_HOME": "./ontologia",
        "AUTO_ONTOLOGY_TOOLSETS": "knowledge",
        "AUTO_ONTOLOGY_ALLOW_DATASOURCE_TOOLS": "0"
      }
    }
  }
}
