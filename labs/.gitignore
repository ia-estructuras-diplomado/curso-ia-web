# Entorno virtual centralizado (no commitear)
.venv/

# Cachés Python
__pycache__/
*.py[cod]

# Lab 4 — datasets descomprimidos (usar zips versionados)
lab4/part_1/data/cracks_subset/
lab4/part_1/data/*.rar
lab4/part_1/data/_tmp_extract/
lab4/part_1/tools/
lab4/part_2/data/building_health_monitoring_dataset.csv

# Lab 5/6 — índice RAG y modelo de embeddings del servidor MCP "normas"
lab5/rag/*
!lab5/rag/config.yaml
# Páginas intermedias del OCR (solo para reanudar ocr_e030.py); el PDF final sí se versiona.
lab5/pdfs_ocr/pages/
# Índice vacío que dejaba knowledge-rag al resolver KNOWLEDGE_RAG_DIR dos veces.
# labs/mcp/sitecustomize.py ya fija la ruta absoluta; estas carpetas son restos.
lab5/lab5/
lab5/rag/rag/

# Lab 6 — salidas de los agentes y modelos ETABS de práctica sueltos
lab6/resultados/
lab6/*.edb
lab6/*.EDB

# Lab 6 — tienda del servidor MCP "auto-ontology" (conceptos/pasajes E.030)
lab6/ontologia/

# Sidecars que ETABS escribe al abrir o analizar los ejemplos
lab6/ejemplos/*.LOG
lab6/ejemplos/*.OUT
lab6/ejemplos/*.$et
lab6/ejemplos/*.ico
lab6/ejemplos/*.Y*
lab6/ejemplos/*.K_*
lab6/ejemplos/manifiesto.json

# Claude Code — permisos locales de cada alumno
**/.claude/settings.local.json
